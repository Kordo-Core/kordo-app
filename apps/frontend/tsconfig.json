{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".", 
    "paths": {
      "core/*": ["../../core/*"],
      "libraries/kordo-ui/*": ["../../libraries/kordo-ui/src/*"],
      "libraries/kordo-ui": ["../../libraries/kordo-ui/src/index"]
    },
    "types": ["react", "react-native"],
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
