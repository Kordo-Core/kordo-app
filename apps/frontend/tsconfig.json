{
  "compilerOptions": {
    "types": [
      "react",
      "react-native"
    ],
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "kordo-ui": [
        "../../kordo-ui/src"
      ]
    },
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
