{
  "name": "kordo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "start:mobile": "pnpm --filter frontend start",
    "storybook": "pnpm --filter kordo-ui storybook",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "validate-branch-name": {
    "pattern": "^(main|preprod|develop|dev)$|^(feature|fix|refactor|chore|docs|style|perf|test)/[a-z0-9-]+$",
    "errorMsg": "branche invalide. format: <type>/<description-kebab-case>\\nexemples: feature/tracking-export, fix/search-bug"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "validate-branch-name": "^1.3.2"
  }
}
