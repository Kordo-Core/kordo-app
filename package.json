{
  "name": "kordo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter apps/backend dev",
    "start:mobile": "pnpm --filter apps/frontend start",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "validate-branch-name": {
    "pattern": "^(main|preprod|develop|dev)$|^(feat|fix|refactor|chore|docs|style|perf|test)/[a-z0-9-]+$",
    "errorMsg": "branche invalide. format: <type>/<description-kebab-case>\\nexemples: feat/tracking-export, fix/search-bug"
  },
  "dependencies": {
    "@emotion/native": "^11.11.0",
    "@emotion/react": "^11.14.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-runtime": "6.1.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "validate-branch-name": "^1.3.2"
  }
}
